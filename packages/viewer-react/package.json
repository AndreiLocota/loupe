{
  "name": "@veridox-ai/loupe-react",
  "version": "2.0.0",
  "description": "React bindings (provider, surface, hooks) for the Loupe headless document viewer.",
  "keywords": [
    "react",
    "document-viewer",
    "pdf",
    "docx",
    "hooks"
  ],
  "license": "UNLICENSED",
  "author": "Veridox",
  "homepage": "https://github.com/AndreiLocota/loupe#readme",
  "bugs": {
    "url": "https://github.com/AndreiLocota/loupe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreiLocota/loupe.git",
    "directory": "packages/viewer-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@veridox-ai/loupe-core": "^0.3.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}

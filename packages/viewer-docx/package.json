{
  "name": "@veridox-ai/loupe-docx",
  "version": "3.0.2",
  "description": "DOCX adapter for the Loupe headless document viewer (canvas rendering via @silurus/ooxml).",
  "keywords": [
    "docx",
    "word",
    "document-viewer",
    "viewer"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Veridox",
  "homepage": "https://github.com/AndreiLocota/loupe#readme",
  "bugs": {
    "url": "https://github.com/AndreiLocota/loupe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreiLocota/loupe.git",
    "directory": "packages/viewer-docx"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@silurus/ooxml": "0.86.0",
    "jszip": "3.10.1"
  },
  "peerDependencies": {
    "@veridox-ai/loupe-core": "^0.3.1"
  }
}

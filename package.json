{
  "name": "loupe-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsup --config tsup.config.ts && npm run build:assets && npm run build:example",
    "build:assets": "npm run build:assets:docx-browser && npm run build:assets:tiff && npm run build:assets:pdf && npm run build:assets:copy",
    "build:example": "npx esbuild examples/viewer-app.tsx --bundle --format=esm --outfile=examples/viewer-app.bundle.js --external:pdfjs-dist --external:@silurus/ooxml",
    "build:assets:docx-browser": "npx esbuild packages/viewer-docx/src/index.ts --bundle --format=esm --external:@veridox-ai/loupe-core --external:@silurus/ooxml --outfile=packages/viewer-docx/dist/browser.js",
    "build:assets:tiff": "mkdir -p packages/viewer-image/dist/workers && npx esbuild --bundle --format=esm --outfile=packages/viewer-image/dist/workers/tiff.worker.js packages/viewer-image/src/workers/tiff.worker.ts",
    "build:assets:pdf": "mkdir -p packages/viewer-pdf/dist/workers && cp node_modules/pdfjs-dist/build/pdf.worker.mjs packages/viewer-pdf/dist/workers/pdf.worker.js",
    "build:assets:copy": "mkdir -p examples/workers && cp packages/viewer-image/dist/workers/tiff.worker.js packages/viewer-pdf/dist/workers/pdf.worker.js examples/workers/",
    "dev": "serve . --listen tcp://127.0.0.1:5173",
    "lint": "eslint packages examples scripts --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:security": "playwright test --config playwright.security.config.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run verify-corpus && npm run test:browser && npm run test:security",
    "generate-corpus": "tsx scripts/generate-corpus.ts",
    "verify-corpus": "tsx scripts/generate-corpus.ts && tsx scripts/verify-corpus.ts",
    "pretest:security": "npm run generate-corpus",
    "dev:packages": "tsup --config tsup.config.ts --watch",
    "pack:packages": "node scripts/pack-packages.mjs",
    "verify:packages": "node scripts/verify-packages.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "8.57.1",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "serve": "14.2.6",
    "tsup": "8.5.1",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@silurus/ooxml": "0.86.0",
    "heic-to": "1.4.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "utif": "3.1.0"
  },
  "description": "Loupe headless document viewer \u2014 monorepo (PDF, DOCX, image adapters + React bindings).",
  "license": "UNLICENSED"
}
